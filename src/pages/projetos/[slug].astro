---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardVideo from '../../components/CardVideo.astro';
import Icone from '../../components/Icone.astro';
import { linkWhatsApp, mensagens } from '../../config/site';
import { url, urlProjeto, urlYouTube } from '../../lib/url';

export async function getStaticPaths() {
  const todos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return todos.map((projeto, i) => ({
    params: { slug: projeto.data.slug },
    props: { projeto, anterior: todos[i - 1], proximo: todos[i + 1] },
  }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
  anterior?: CollectionEntry<'projetos'>;
  proximo?: CollectionEntry<'projetos'>;
}
const { projeto, anterior, proximo } = Astro.props;
const p = projeto.data;
const vertical = p.formato === 'vertical';
---
<Base titulo={`${p.titulo} — Paulo Padilha`} descricao={`${p.descricao} ${p.categoria}. Motion design e edição de vídeo por Paulo Padilha.`} caminho={`projetos/${p.slug}/`}>
  <article class="projeto">
    <div class="container">
      <nav aria-label="Trilha" class="trilha">
        <a href={url('#work')}><Icone nome="seta-esq" /> Todos os trabalhos</a>
      </nav>

      <div class:list={['grade', { vertical }]}>
        <div class="midia">
          <CardVideo
            projeto={projeto}
            prioridade
            semLinkProjeto
            tamanhos={vertical ? '(max-width: 640px) 80vw, 380px' : '(max-width: 900px) 92vw, 720px'}
          />
        </div>
        <div class="texto">
          <p class="tag">{p.categoria}</p>
          <h1>{p.titulo}</h1>
          <p class="descricao">{p.descricao}</p>
          <dl class="ficha">
            <div><dt>Formato</dt><dd>{vertical ? 'Vertical · 9:16' : 'Horizontal · 16:9'}</dd></div>
            <div><dt>Categoria</dt><dd>{p.categoria}</dd></div>
          </dl>
          <div class="acoes">
            <a class="btn btn-claro" href={linkWhatsApp(mensagens.projeto(p.titulo))} target="_blank" rel="noopener noreferrer">
              <Icone nome="whatsapp" /> Quero algo assim
            </a>
            <a class="btn btn-contorno" href={urlYouTube(p.video)} target="_blank" rel="noopener noreferrer">
              Assistir no YouTube <Icone nome="externo" />
            </a>
          </div>
        </div>
      </div>

      <nav class="vizinhos" aria-label="Outros projetos">
        {anterior ? (
          <a href={urlProjeto(anterior.data.slug)} rel="prev"><span>Anterior</span><strong>{anterior.data.titulo}</strong></a>
        ) : <span />}
        {proximo && (
          <a href={urlProjeto(proximo.data.slug)} rel="next" class="prox"><span>Próximo</span><strong>{proximo.data.titulo}</strong></a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .projeto { padding: var(--s-6) 0 var(--section-y); }
  .trilha a { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px; color: var(--muted); text-decoration: none; font-size: var(--fs-sm); }
  .trilha a:hover { color: var(--text); }
  .trilha :global(svg) { width: 16px; height: 16px; }

  .grade { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s-7); align-items: center; margin-top: var(--s-5); }
  .grade.vertical { grid-template-columns: minmax(0, 380px) minmax(0, 1fr); }
  .tag { font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: var(--s-3); }
  h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.4rem, 0.25rem + 6vw, 3.6rem); line-height: 1.02; letter-spacing: -0.02em; text-transform: uppercase; margin-bottom: var(--s-4); }
  .descricao { color: var(--muted); font-size: var(--fs-lg); margin-bottom: var(--s-5); max-width: 520px; }
  .ficha { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
  .ficha div { display: flex; gap: var(--s-3); border-bottom: 1px solid var(--border); padding-bottom: var(--s-3); }
  .ficha dt { min-width: 96px; color: var(--muted); font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 0.08em; }
  .ficha dd { font-size: var(--fs-sm); }
  .acoes { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .acoes .btn-contorno :global(svg) { width: 14px; height: 14px; }

  .vizinhos { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-8); border-top: 1px solid var(--border); padding-top: var(--s-5); }
  .vizinhos a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; padding: var(--s-2) 0; max-width: 48%; }
  .vizinhos span { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .vizinhos strong { font-weight: 600; }
  .vizinhos a:hover strong { text-decoration: underline; }
  .vizinhos .prox { text-align: right; margin-left: auto; }

  @media (max-width: 900px) {
    .grade, .grade.vertical { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .grade.vertical .midia { max-width: 340px; width: 100%; margin-inline: auto; }
  }
</style>
