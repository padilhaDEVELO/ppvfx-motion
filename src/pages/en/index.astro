---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CardVideo from '../../components/CardVideo.astro';
import VitrineIA from '../../components/VitrineIA.astro';
import { contato, linkWhatsApp } from '../../config/site';
import { url } from '../../lib/url';
const all = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const bySlug = (slug: string) => all.find(p => p.data.slug === slug)!;
const selected = ['producao-completa', 'apresentacao-de-marca', 'motion-grafico', 'animacao-para-feed'].map(bySlug);
const studies = all.filter(p => p.data.en.group === 'estudo');
const message = linkWhatsApp('Hi Paulo, I saw your portfolio and would like to discuss a remote video editing or motion design opportunity.');
const experience = [
  { company: 'FEBRACIS PARÁ', role: 'Videomaker · Video editing & motion design', dates: 'Jun 2025 — Present', text: 'Videos for Reels and learning platforms, animated typography and 3D logo animation.' },
  { company: 'Municipal Government of Ananindeua', role: 'Video editor · Remote', dates: 'Aug 2024 — Jun 2025', text: 'Social media editing and stories about public services and the people behind them.' },
  { company: 'Front Saúde', role: 'Video production & design', dates: 'Nov 2023 — Jun 2025', text: 'Filming, editing and visual content for digital communication.' },
  { company: 'TV RBA / BAND', role: 'Audiovisual production', dates: 'Jan 2023 — Feb 2024', text: 'Multiplatform production, filming, editing and visual communication.' },
  { company: 'Global Prime Solutions', role: 'Graphic design & video editing', dates: 'Oct 2020 — Oct 2021', text: 'Graphic assets, image compositing, video editing and motion design.' },
];
---
<Base idioma="en" caminho="en/" titulo="Paulo Padilha — Video Editor & Motion Designer" descricao="Video editing and motion design for social media, brands and educational content. Explore Paulo Padilha’s work. Based in Brazil, open to remote opportunities.">
  <section id="home" class="container hero">
    <div class="intro">
      <p class="eyebrow">Paulo Padilha / PP VFX</p>
      <h1>Video editor.{' '}<br /><span class="grad-text">Motion{' '}<br />designer.</span></h1>
      <p class="lead">I shape footage, type and graphics into stories for social media, brands and education.</p>
      <p class="location">Belém, Brazil · UTC−3{' '}<br />Open to remote roles &amp; contract work</p>
      <div class="actions">
        <a class="btn btn-claro" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={contato.linkedin} target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="filmstrip" aria-label="Preview frames from selected projects">
      {selected.slice(0, 3).map((p, i) => <a class:list={['frame', `frame-${i}`]} href={url(`en/work/${p.data.slug}/`)} aria-label={`Explore ${p.data.en.title}`}>
        <Picture src={p.data.capa} formats={['avif','webp']} widths={[270,405]} sizes="(max-width: 700px) 28vw, 180px" alt="" loading="eager" />
        <span>{['Video + motion', 'Brand stories', 'Logo animation'][i]}</span>
      </a>)}
      <p class="strip-caption">Real frames. Selected work below.</p>
    </div>
  </section>

  <section id="work" class="container work section">
    <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Footage meets{' '}<br />motion.</h2></div><p>Explore the finished pieces and the part I contributed to each project.</p></div>
    <div class="work-grid">
      {selected.map(p => <div class="work-item">
        <CardVideo projeto={p} idioma="en" tamanhos="(max-width: 600px) 68vw, 270px" />
        <div class="project-copy"><h3>{p.data.en.title}</h3><p>{p.data.en.context}</p><p class="role"><span>My contribution</span>{p.data.en.role}</p></div>
      </div>)}
    </div>
  </section>

  <section id="ai" class="container section">
    <div class="section-heading"><div><p class="eyebrow">New · 3D parallax with AI</p><h2>AI-made{' '}<br /><span class="grad-text">videos.</span></h2></div><p>A still photo becomes a moving scene: AI separates the layers and builds depth; camera, light and typography are motion design.</p></div>
    <VitrineIA idioma="en" />
  </section>

  <section id="studies" class="section studies">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Animation studies</p><h2>Exploring visual{' '}<br />storytelling.</h2></div><p>Test pieces exploring identity, historical imagery and educational animation.</p></div>
      <div class="studies-grid">
        {studies.map(p => <div class:list={['study', {portrait: p.data.formato === 'vertical'}]}>
          <CardVideo projeto={p} idioma="en" tamanhos="(max-width: 700px) 85vw, 520px" />
          <h3>{p.data.en.title}</h3><p>{p.data.en.context}</p>
          <p class="study-note">{p.data.en.note}</p>
        </div>)}
      </div>
    </div>
  </section>

  <section id="expertise" class="container section">
    <div class="section-heading"><div><p class="eyebrow">What I bring</p><h2>From the cut{' '}<br />to the finish.</h2></div><p>Adobe Premiere Pro &amp; After Effects are my core tools.</p></div>
    <div class="expertise-grid">
      <div><h3>Video editing</h3><p>Social media, Reels, branded stories and educational content. Selecting footage and shaping a clear narrative.</p></div>
      <div><h3>Motion design</h3><p>Animated typography, graphic elements and logo animation that support the message and visual identity.</p></div>
      <div><h3>Visual finishing</h3><p>Color grading and compositing to bring footage and graphics together in the finished piece.</p></div>
    </div>
  </section>

  <section id="about" class="container section experience">
    <div class="about-intro"><p class="eyebrow">Experience</p><h2>Stories from{' '}<br />Brazil.</h2><p>My background spans education, healthcare, public communication and television. I work across editing and motion design, with experience in filming and graphic design.</p><a class="text-link" href={contato.linkedin} target="_blank" rel="noopener noreferrer">Full experience on LinkedIn ↗</a></div>
    <ol class="timeline" role="list">{experience.map(e => <li><p class="dates">{e.dates}</p><h3>{e.company}</h3><p class="job-role">{e.role}</p><p>{e.text}</p></li>)}</ol>
  </section>

  <section id="contact" class="section contact">
    <div class="container contact-grid">
      <div><p class="eyebrow">Remote opportunities</p><h2>Let’s talk{' '}<br /><span class="grad-text">about the role.</span></h2></div>
      <div><p>I’m open to video editing and motion design opportunities with teams in the United States, Canada, Portugal and Brazil.</p><dl class="availability"><div><dt>Based in</dt><dd>Belém, Brazil · UTC−3</dd></div><div><dt>Work setup</dt><dd>Remote from Brazil</dd></div><div><dt>Languages</dt><dd>Portuguese · Conversational English</dd></div></dl><div class="actions"><a class="btn btn-claro" href={contato.linkedin} target="_blank" rel="noopener noreferrer">Contact on LinkedIn ↗</a><a class="btn btn-contorno" href={message} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div></div>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 48px; padding-block: clamp(56px, 7vw, 100px); min-height: 690px; }
  .eyebrow { color: var(--from); text-transform: uppercase; font-size: .75rem; letter-spacing: .14em; font-weight: 600; margin-bottom: 22px; }
  h1, h2 { font-family: var(--font-display); font-weight: 800; letter-spacing: -.045em; line-height: 1.03; }
  h1 { font-size: clamp(2.1rem, 4.1vw, 3.35rem); hyphens: none; }
  h2 { font-size: clamp(2.35rem, 4.7vw, 3.6rem); }
  h3 { font-size: 1.1rem; line-height: 1.35; margin-bottom: 10px; }
  .lead { font-size: 1.2rem; max-width: 490px; margin-top: 28px; color: var(--muted); }
  .location { margin-top: 22px; font-size: .88rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 28px; }
  .text-link { display: inline-block; font-size: .9rem; padding-block: 12px; text-underline-offset: 5px; }
  .filmstrip { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); align-items: center; gap: 12px; padding-block: 35px; }
  .frame { position: relative; overflow: hidden; border-radius: 10px; border: 1px solid var(--border); aspect-ratio: 9 / 16; text-decoration: none; box-shadow: 0 18px 50px #0006; transition: transform .25s; }
  .frame-0 { transform: translateY(28px); }.frame-2 { transform: translateY(-28px); }
  .frame:hover { transform: translateY(-6px); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame span { position: absolute; bottom: 0; left: 0; right: 0; padding: 50px 12px 14px; background: linear-gradient(transparent, #090c12); color: #fff; font-size: .7rem; line-height: 1.4; }
  .strip-caption { grid-column: 1 / -1; padding-top: 28px; text-align: center; font-size: .7rem; color: var(--muted); letter-spacing: .04em; }
  .section { padding-block: clamp(64px, 8vw, 104px); border-top: 1px solid var(--border); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 32px; margin-bottom: 54px; }
  .section-heading > p { max-width: 320px; color: var(--muted); }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 60px 45px; }
  .work-item { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0,1fr); align-items: center; gap: 24px; }
  .project-copy p { color: var(--muted); font-size: .9rem; }
  .project-copy .role { margin-top: 24px; color: var(--text); }
  .role span { display: block; text-transform: uppercase; letter-spacing: .1em; font-size: .65rem; color: var(--from); margin-bottom: 6px; }
  .studies { background: #1b1f2a55; }
  .studies-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 42px; }
  .study { min-width: 0; }.study.portrait { grid-row: span 2; max-width: 320px; margin-inline: auto; }
  .study h3 { margin-top: 16px; }.study p { color: var(--muted); font-size: .9rem; }
  .study .study-note { font-size: .78rem; margin-top: 12px; }
  .expertise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .expertise-grid > div { border-top: 2px solid var(--border); padding-top: 24px; }
  .expertise-grid p { color: var(--muted); }
  .experience { display: grid; grid-template-columns: 1fr 1.15fr; gap: 100px; }
  .about-intro > p:not(.eyebrow) { color: var(--muted); margin-top: 28px; }
  .timeline li { padding-block: 25px; border-bottom: 1px solid var(--border); }.timeline li:first-child { padding-top: 0; }
  .timeline p { color: var(--muted); font-size: .9rem; }.timeline .dates { font-size: .75rem; margin-bottom: 10px; color: var(--from); }.timeline .job-role { color: var(--text); margin-bottom: 8px; }
  .contact { background: #1b1f2a66; }.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 65px; }
  .contact-grid > div > p:not(.eyebrow) { color: var(--muted); }
  .availability { margin-top: 28px; font-size: .85rem; }.availability div { display: grid; grid-template-columns: 100px 1fr; gap: 16px; padding-block: 10px; border-bottom: 1px solid var(--border); }.availability dt { color: var(--muted); }
  @media (max-width: 1050px) { .hero { gap: 28px; }.work-item { grid-template-columns: 1fr; }.work-item :global(.card) { width: min(100%, 280px); margin-inline: auto; }.experience { gap: 45px; } }
  @media (max-width: 700px) {
    .hero { grid-template-columns: 1fr; padding-top: 52px; gap: 18px; min-height: auto; }.hero h1 { font-size: clamp(2.1rem, 7vw, 3.3rem); }.filmstrip { max-width: 480px; width: 100%; margin-inline: auto; padding-bottom: 0; }
    .section-heading { display: block; margin-bottom: 32px; }.section-heading > p { margin-top: 22px; }.work-grid { gap: 44px 25px; }.project-copy p { font-size: .85rem; }
    .studies-grid { grid-template-columns: 1fr; }.study.portrait { grid-row: auto; }.expertise-grid { grid-template-columns: 1fr; gap: 26px; }.experience,.contact-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 450px) { .work-grid { grid-template-columns: 1fr; }.project-copy { max-width: 320px; margin-inline: auto; }.work-item { gap: 10px; }.actions { gap: 14px; }.availability div { grid-template-columns: 84px 1fr; gap: 8px; } }
</style>
