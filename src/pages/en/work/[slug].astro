---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CardVideo from '../../../components/CardVideo.astro';
import Icone from '../../../components/Icone.astro';
import { contato } from '../../../config/site';
import { url, urlYouTube } from '../../../lib/url';
export async function getStaticPaths() {
  const all = (await getCollection('projetos')).sort((a,b) => a.data.ordem - b.data.ordem);
  return all.map((projeto, i) => ({ params: { slug: projeto.data.slug }, props: { projeto, next: all[(i + 1) % all.length] } }));
}
interface Props { projeto: CollectionEntry<'projetos'>; next: CollectionEntry<'projetos'>; }
const { projeto, next } = Astro.props;
const p = projeto.data;
const e = p.en;
---
<Base idioma="en" caminho={`en/work/${p.slug}/`} titulo={`${e.title} — Paulo Padilha`} descricao={`${e.context} My contribution: ${e.role}.`}>
  <article class="container project">
    <a class="back" href={url('en/#work')}><Icone nome="seta-esq" /> All work</a>
    <div class:list={['grid', {vertical: p.formato === 'vertical'}]}>
      <div class="media"><CardVideo projeto={projeto} idioma="en" prioridade semLinkProjeto tamanhos={p.formato === 'vertical' ? '(max-width: 640px) 85vw, 350px' : '(max-width: 900px) 90vw, 680px'} /></div>
      <div class="copy"><p class="eyebrow">{e.category}</p><h1>{e.title}</h1><p class="context">{e.context}</p>
        <dl><div><dt>My contribution</dt><dd>{e.role}</dd></div><div><dt>Format</dt><dd>{p.formato === 'vertical' ? 'Vertical · 9:16' : 'Widescreen · 16:9'}</dd></div></dl>
        <h2>What to look for</h2><p>{e.focus}</p>
        {e.note && <p class="note">{e.note}</p>}
        <div class="actions"><a class="btn btn-claro" href={contato.linkedin} target="_blank" rel="noopener noreferrer">Discuss an opportunity <Icone nome="externo" /></a><a class="btn btn-contorno" href={urlYouTube(p.video)} target="_blank" rel="noopener noreferrer">Watch on YouTube <Icone nome="externo" /></a></div>
      </div>
    </div>
    <nav class="next" aria-label="More work"><a href={url('en/#work')}>Back to selected work</a><a href={url(`en/work/${next.data.slug}/`)}>Next: {next.data.en.title} <Icone nome="seta-dir" /></a></nav>
  </article>
</Base>
<style>
  .project { padding-block: 36px 90px; }.back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-bottom: 36px; color: var(--muted); text-underline-offset: 4px; }
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 50px; align-items: center; }.grid.vertical { grid-template-columns: 350px 1fr; gap: 80px; }.copy { max-width: 580px; min-width: 0; }
  .eyebrow { color: var(--from); font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 18px; }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.06; letter-spacing: -.04em; }.context { margin-block: 24px; font-size: 1.05rem; }
  p { color: var(--muted); }dl { margin-block: 24px; }dl div { border-bottom: 1px solid var(--border); padding-block: 12px; }dt { color: var(--from); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }dd { margin-top: 4px; }
  h2 { font-size: 1rem; margin-bottom: 10px; }.note { margin-top: 20px; border-left: 2px solid var(--border); padding-left: 16px; font-size: .85rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }.next { display: flex; justify-content: space-between; gap: 25px; border-top: 1px solid var(--border); padding-top: 28px; margin-top: 70px; font-size: .9rem; }.next a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; text-underline-offset: 4px; }
  .back :global(svg), .next :global(svg), .actions :global(svg) { width: 14px; height: 14px; flex-shrink: 0; }
  @media(max-width: 900px) { .grid, .grid.vertical { grid-template-columns: 1fr; gap: 36px; }.vertical .media { width: min(100%, 350px); margin-inline: auto; }.next { flex-wrap: wrap; } }
</style>
